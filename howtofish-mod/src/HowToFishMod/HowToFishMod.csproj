<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HowToFishMod</AssemblyName>
    <RootNamespace>HowToFishMod</RootNamespace>
    <Version>0.0.1</Version>
    <Description>Personal-use mod pack for How to Fish (Dazed Games). BepInEx 5 plugin.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    После того как пользователь загрузит файлы игры, сюда будут добавлены ссылки:
    <ItemGroup>
      <Reference Include="BepInEx"><HintPath>..\..\libs\BepInEx.dll</HintPath></Reference>
      <Reference Include="0Harmony"><HintPath>..\..\libs\0Harmony.dll</HintPath></Reference>
      <Reference Include="Assembly-CSharp"><HintPath>..\..\libs\Assembly-CSharp.dll</HintPath></Reference>
      <Reference Include="UnityEngine"><HintPath>..\..\libs\UnityEngine.dll</HintPath></Reference>
    </ItemGroup>
  -->

</Project>
